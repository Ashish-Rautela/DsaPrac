# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secrets & Cookies
JWT_SECRET=super_secret_jwt_key_replace_in_production_32chars
JWT_EXPIRES_IN=7d

# AWS DynamoDB Configuration
AWS_REGION=ap-south-1
USERS_TABLE=VisaPrep_Users
QUESTIONS_TABLE=VisaPrep_Questions
PAYMENTS_TABLE=VisaPrep_Payments
PROGRESS_TABLE=VisaPrep_Progress

# AWS S3 Storage for Payment Screenshots
S3_BUCKET_NAME=visaprep-payment-proofs
S3_PUBLIC_URL=

# Set to true for running tests or local development without real AWS credentials
USE_LOCAL_MOCK=false
DYNAMODB_ENDPOINT=

# UPI Payment Details for Manual Review
UPI_ID=visaprep@upi
UPI_PAYEE_NAME=Visa OA Prep Platform
UPI_AMOUNT_INR=20

# CORS
CLIENT_ORIGIN=http://localhost:5173
